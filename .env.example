# Firebase web app config (from Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Use "(default)" for the default Firestore database, or your named database id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Auth setup:
# 1. Enable Google provider (and authorized domains including localhost)
# 2. Deploy firestore.rules
