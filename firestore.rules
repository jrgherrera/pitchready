rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Mirrored in src/utils/matches.ts (SUPER_ADMIN_EMAIL) — keep both in sync
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'jrgherrera@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().admin == true;
    }

    // Matches — admins create; only the creator (or super admin) edits; anyone joins
    match /matches/{matchId} {
      // Fields a player changes by joining, leaving, or bringing a +1
      // roster rides as dotted `roster.<uid>` keys: the caller may touch only their own entry.
      // (Promotion adds other uids to joinedPlayerIds, never to roster — they wrote their own when they joined.)
      function onlyRosterChanged() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['joinedPlayerIds', 'waitlistPlayerIds', 'guests', 'memberIds', 'roster', 'updatedAt'])
          && (!changed.hasAny(['roster'])
            || request.resource.data.roster.diff(resource.data.get('roster', {})).affectedKeys()
              .hasOnly([request.auth.uid]));
      }

      function occupied(d) {
        return d.joinedPlayerIds.size() + d.get('guests', []).size();
      }

      // Never grow past capacity, but a legacy or host-shrunk match already over it can still shrink
      function withinCapacity() {
        return occupied(request.resource.data) <= occupied(resource.data)
          || occupied(request.resource.data) <= request.resource.data.capacity;
      }

      // Super admin first: legacy docs may lack creatorId, and a missing-key read denies
      function isMatchOwner() {
        return isSignedIn()
          && (isSuperAdmin() || resource.data.get('creatorId', '') == request.auth.uid);
      }

      allow read: if isSignedIn();

      allow create: if (isAdmin() || isSuperAdmin())
        && isValidId(matchId)
        && request.resource.data.creatorId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(matchId)
        && (isMatchOwner() || (onlyRosterChanged() && withinCapacity()));

      allow delete: if isMatchOwner();
    }

    // Match previews — readable by link, holds nothing that identifies a player.
    // Owner = creator (or super admin) of the match with the same id.
    match /matchPreviews/{matchId} {
      function ownsMatch(matchData) {
        return isSignedIn()
          && (isSuperAdmin() || matchData.get('creatorId', '') == request.auth.uid);
      }

      allow get: if true;
      allow list: if false;

      // getAfter: the match may be created in the same batch
      allow create: if isValidId(matchId)
        && existsAfter(/databases/$(database)/documents/matches/$(matchId))
        && ownsMatch(getAfter(/databases/$(database)/documents/matches/$(matchId)).data);

      allow update: if isSignedIn()
        && isValidId(matchId)
        && (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['occupiedCount', 'status', 'updatedAt'])
            || ownsMatch(get(/databases/$(database)/documents/matches/$(matchId)).data));

      // get (pre-batch state): the match may be deleted in the same batch
      allow delete: if isValidId(matchId)
        && ownsMatch(get(/databases/$(database)/documents/matches/$(matchId)).data);
    }

    // Users — owner writes only; clients cannot grant themselves admin
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidId(userId)
        && request.resource.data.get('admin', false) == false;

      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidId(userId)
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);

      allow delete: if false;
    }
  }
}
