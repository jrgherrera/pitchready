rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().admin == true;
    }

    // Matches — only admins can create; any signed-in user can join/update
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(matchId);
      allow update: if isSignedIn() && isValidId(matchId);
      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.creatorId == request.auth.uid || resource.data.creatorId == null);
    }

    // Users — owner writes only; clients cannot grant themselves admin
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidId(userId)
        && request.resource.data.get('admin', false) == false;

      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidId(userId)
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);

      allow delete: if false;
    }
  }
}
